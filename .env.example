# Vercel Deployment & Environment Variables Example
PORT=5000
NODE_ENV=production

# MongoDB Atlas Database Connection URI (required on Vercel)
MONGODB_URI=mongodb+srv://auditapp4_db_user:3s01SQq1CHJKoSJ1@cluster0.sfi3e1k.mongodb.net/esm_plant_audit

# Authentication & JWT Secrets (required on Vercel)
JWT_SECRET=esm_plant_audit_super_secret_jwt_key_2026_secured
JWT_ACCESS_SECRET=esm_plant_audit_super_secret_jwt_key_2026_secured
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=esm_plant_audit_refresh_secret_key_2026_secured
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=esm_cookie_secret_key_plant_audit_2026

# Frontend URLs for CORS & Cookies (set to your Vercel frontend URL, e.g. https://your-app.vercel.app)
APP_BASE_URL=https://your-frontend-app.vercel.app
FRONTEND_URL=https://your-frontend-app.vercel.app
API_BASE_URL=https://your-backend-api.vercel.app

# Ephemeral File Storage on Vercel (automatically defaults to /tmp on Vercel)
UPLOAD_DIR=/tmp/uploads

# SMTP Mailer (optional for password reset emails)
